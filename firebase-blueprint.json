{
  "collections": {
    "users": {
      "rules": {
        "read": "request.auth != null",
        "write": "request.auth != null && request.auth.uid == id"
      },
      "schema": {
        "name": "string",
        "code": "string",
        "createdAt": "timestamp"
      }
    },
    "chats": {
      "rules": {
        "read": "request.auth != null && request.auth.uid in resource.data.participants",
        "create": "request.auth != null && request.auth.uid in request.resource.data.participants",
        "update": "request.auth != null && request.auth.uid in resource.data.participants"
      },
      "schema": {
        "type": "string",
        "name": "string?",
        "participants": "list<string>",
        "lastMessage": "string?",
        "lastMessageTime": "timestamp?"
      },
      "subcollections": {
        "messages": {
          "rules": {
            "read": "request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants",
            "create": "request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && request.resource.data.senderId == request.auth.uid"
          },
          "schema": {
            "senderId": "string",
            "text": "string?",
            "type": "string",
            "fileUrl": "string?",
            "fileName": "string?",
            "timestamp": "timestamp"
          }
        }
      }
    }
  }
}
